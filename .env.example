# Google Gemini API key (client-side, dev/demo only — proxy it in production)
VITE_GEMINI_API_KEY=your_api_key_here

# Model id used for streaming chat
VITE_GEMINI_MODEL=gemini-2.0-flash

# Optional: path/URL to a rigged GLB robot (leave empty to use the procedural fallback robot)
VITE_ROBOT_MODEL_URL=/models/robot.glb
