{
  "name": "aivora",
  "private": true,
  "version": "1.0.0",
  "description": "Aivora — Interactive 3D AI Assistant (React + TypeScript + Three.js + Gemini)",
  "type": "module",
  "scripts": {
    "dev": "vite",
